{
  "name": "RagFlow - RAG Query",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rag-query",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "node-q-001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "rag-query"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "assign-001",
              "name": "chatInput",
              "value": "={{ $json?.chatInput || $json.body.question }}",
              "type": "string"
            },
            {
              "id": "assign-002",
              "name": "sessionId",
              "value": "={{ $json?.sessionId || $json.body.documentId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "node-q-002",
      "name": "Edit Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.chatInput }}",
        "options": {
          "systemMessage": "You are an intelligent document assistant. Use the RAG tool to look up relevant information from the user's documents and answer their questions accurately.\n\nWhen searching, use specific keywords from the user's original question. For example:\n- If the user asks about 'arriving late', search for 'late arrival' not 'leave application'\n- If the user asks about a specific rule or policy, include the exact behavior or action in your search query\n- Try multiple searches with different keyword combinations if the first search does not return relevant results\n\nAlways base your answers on the retrieved context. If you cannot find relevant information after trying different search queries, say so clearly. Do not make up information."
        }
      },
      "id": "node-q-003",
      "name": "RAG AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.6,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "model": "qwen/qwen-2.5-72b-instruct",
        "options": {}
      },
      "id": "node-q-004",
      "name": "OpenRouter Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        560,
        520
      ],
      "credentials": {
        "openAiApi": {
          "id": "openrouter-openai-api",
          "name": "OpenRouter (OpenAI-compatible)"
        }
      }
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolDescription": "Use RAG to look up relevant information from uploaded documents.",
        "pineconeIndex": {
          "__rl": true,
          "value": "ragflow-docs",
          "mode": "list",
          "cachedResultName": "ragflow-docs"
        },
        "topK": 10,
        "options": {
          "filter": "={{ $('Edit Fields').first().json.sessionId ? JSON.stringify({ documentId: { '$eq': $('Edit Fields').first().json.sessionId } }) : '' }}"
        }
      },
      "id": "node-q-005",
      "name": "Pinecone Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1,
      "position": [
        740,
        520
      ],
      "credentials": {
        "pineconeApi": {
          "id": "pinecone-api",
          "name": "Pinecone API"
        }
      }
    },
    {
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      },
      "id": "node-q-006",
      "name": "Embeddings OpenAI",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1,
      "position": [
        740,
        700
      ],
      "credentials": {
        "openAiApi": {
          "id": "openai-api",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.sessionId || 'global' }}",
        "options": {}
      },
      "id": "node-q-007",
      "name": "Postgres Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1,
      "position": [
        920,
        520
      ],
      "credentials": {
        "postgres": {
          "id": "ragflow-db",
          "name": "RagFlow Database"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ answer: $json.output, sources: [] }) }}",
        "options": {}
      },
      "id": "node-q-008",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        900,
        300
      ]
    }
  ],
